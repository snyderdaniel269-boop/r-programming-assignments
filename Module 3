# Define vectors
Name <- c("Jeb", "Donald", "Ted", "Marco", "Carly", "Hillary", "Bernie")
ABC_poll   <- c(  4,      62,      51,    21,      2,        14,       15)
CBS_poll   <- c( 12,      75,      43,    19,      1,        21,       19)

# Combine into a data frame
df_polls <- data.frame(Name, ABC_poll, CBS_poll)

# Inspect the data frame
str(df_polls)
head(df_polls)

# Compute summary statistics
mean_abc <- mean(df_polls$ABC_poll)
median_cbs <- median(df_polls$CBS_poll)
poll_range <- range(df_polls[, c("ABC_poll", "CBS_poll")])

print(paste("Mean ABC Poll:", mean_abc))
print(paste("Median CBS Poll:", median_cbs))
print("Poll Range (Min, Max):")
print(poll_range)

# Add a column for the difference between CBS and ABC
df_polls$Diff <- df_polls$CBS_poll - df_polls$ABC_poll

# Visualize categorical data using ggplot2
library(ggplot2)
library(tidyr)

# Reshape data for plotting
df_long <- pivot_longer(df_polls, cols = c(ABC_poll, CBS_poll), names_to = "Poll", values_to = "Percentage")

# Generate bar chart
ggplot(df_long, aes(x = reorder(Name, Percentage), y = Percentage, fill = Poll)) +
  geom_bar(stat = "identity", position = "dodge") +
  coord_flip() +
  labs(title = "Comparison of ABC and CBS Polls by Candidate",
       x = "Candidate",
       y = "Poll Percentage") +
  theme_minimal()
