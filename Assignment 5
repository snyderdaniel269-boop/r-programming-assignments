# Assignment 4: Working with Matrices in R

# 1. Create the matrices
A <- matrix(1:100, nrow = 10)
B <- matrix(1:1000, nrow = 10)

# 2. Inspect dimensions
cat("--- Dimensions Check ---\n")
cat("Dimensions of A:\n")
print(dim(A))  # Expected: 10 x 10

cat("Dimensions of B:\n")
print(dim(B))  # Expected: 10 x 100 (non-square)

# 3. Compute inverse and determinant with error handling using tryCatch
detA <- tryCatch(det(A), error = function(e) e)
invA <- tryCatch(solve(A), error = function(e) e)

detB <- tryCatch(det(B), error = function(e) e)
invB <- tryCatch(solve(B), error = function(e) e)

# 4. Display Results
cat("\n============================\n")
cat("MATRIX A RESULTS:\n")
cat("============================\n")
cat("Determinant of A:\n")
print(detA)

cat("\nInverse of A:\n")
print(invA)

cat("\n============================\n")
cat("MATRIX B RESULTS:\n")
cat("============================\n")
cat("Determinant of B:\n")
print(detB)

cat("\nInverse of B:\n")
print(invB)
